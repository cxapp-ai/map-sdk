# Copy to demo/.env.local (gitignored via *.local) and fill from the team
# secrets store — do NOT paste secrets into this template or commit them.
#
# The demo uses the dev-only clientId/clientSecret auth mode, which ships the
# secret to the browser. Production hosts must use auth: { getToken } with
# server-minted JACS tokens instead.

VITE_JIBESTREAM_HOST=https://api.jibestream.com   # optional; this is the default
VITE_JIBESTREAM_CUSTOMER_ID=<customer-id>
VITE_JIBESTREAM_VENUE_ID=<venue-id>
VITE_JIBESTREAM_CLIENT_ID=<client-id>
VITE_JIBESTREAM_CLIENT_SECRET=<client-secret>
VITE_JIBESTREAM_MAP_PROFILE_ID=<map-profile-id>   # only if your service account needs it

# ── Optional demo tuning ─────────────────────────────────────────────────────
# Real Jibestream waypointIds on your venue (comma-separated). Unresolved ids
# still show in the carousel + "not shown on map" badge; the engine throws if
# NONE resolve.
# VITE_DEMO_WAYPOINT_IDS=<id1>,<id2>,<id3>
# Where the GPS mock fix lands (put it inside your venue).
# VITE_DEMO_MOCK_LAT=<lat>
# VITE_DEMO_MOCK_LNG=<lng>
