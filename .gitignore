# Dependencies
node_modules/

# Build output — generated at install time via the `prepare` script, never committed
dist/

# Secrets / local env — NEVER commit these. .env.example (placeholders) is tracked.
.env
.env.*
!.env.example
*.local
# Raw-HTML pages read their creds from a config.local.js next to them
# (pages/moo/config.example.js is the tracked template).
pages/**/config.local.js

# Logs & caches
*.log
npm-debug.log*
.npm/
.vite/
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
